        {
            "name": "lastName",
            "federationMapperType": "user-attribute-ldap-mapper",
            "config": {
                "ldap.attribute.name": "sn",
                "user.model.attribute.name": "lastName",
                "read.only": "true",
                "always.read.value.from.ldap": "true",
                "is.mandatory.in.ldap": "false"
            }
        },
        {
            "name": "role-mapper",
            "federationMapperType": "role-ldap-mapper",
            "config": {
                "ldap.roles.dn": "ou=groups,dc=bionicpro,dc=com",
                "role.name.ldap.attribute": "cn",
                "role.object.classes": "groupOfNames",
                "membership.ldap.attribute": "member",
                "membership.user.ldap.attribute": "uid",
                "membership.user.ldap.object.class": "inetOrgPerson",
                "roles.ldap.filter": "",
                "use.realm.roles.mapping": "true",
                "client.id": "",
                "mode": "IMPORT",
                "user.roles.retrieve.strategy": "LOAD_ROLES_BY_MEMBER_ATTRIBUTE",
                "memberof.ldap.attribute": "",
                "memberof.uses.dn": "false"
            }
        }
