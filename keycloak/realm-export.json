    "userFederationProviders": [
        {
            "id": "ldap-provider",
            "providerName": "ldap",
            "config": {
                "enabled": "true",
                "priority": "0",
                "importEnabled": "true",
                "syncRegistrations": "false",
                "editMode": "READ_ONLY",
                "vendor": "other",
                "usernameLDAPAttribute": "uid",
                "rdnLDAPAttribute": "uid",
                "uuidLDAPAttribute": "entryUUID",
                "userObjectClasses": "inetOrgPerson,organizationalPerson",
                "connectionUrl": "ldap://openldap:389",
                "usersDn": "ou=users,dc=bionicpro,dc=com",
                "authType": "simple",
                "bindDn": "cn=admin,dc=bionicpro,dc=com",
                "bindCredential": "admin",
                "searchScope": "1",
                "useTruststoreSpi": "always",
                "connectionPooling": "true",
                "pagination": "true",
                "allowKerberosAuthentication": "false",
                "serverPrincipal": "",
                "keyTab": "",
                "kerberosRealm": "",
                "debug": "false",
                "batchSizeForSync": "1000",
                "fullSyncPeriod": "-1",
                "changedSyncPeriod": "-1",
                "cachePolicy": "DEFAULT",
                "evictionDay": "",
                "evictionHour": "",
                "evictionMinute": "",
                "maxLifespan": "-1",
                "customUserSearchFilter": "",
                "trustEmail": "false",
                "validatePasswordPolicy": "false",
                "usePasswordModifyExtendedOp": "false",
                "readTimeout": "0",
                "connectionTimeout": "0"
            }
        }
    ],
    "userFederationMappers": [
        {
            "name": "username",
            "federationMapperType": "user-attribute-ldap-mapper",
            "config": {
                "ldap.attribute.name": "uid",
                "user.model.attribute.name": "username",
                "read.only": "true",
                "always.read.value.from.ldap": "true",
                "is.mandatory.in.ldap": "true"
            }
        },
        {
            "name": "email",
            "federationMapperType": "user-attribute-ldap-mapper",
            "config": {
                "ldap.attribute.name": "mail",
                "user.model.attribute.name": "email",
                "read.only": "true",
                "always.read.value.from.ldap": "true",
                "is.mandatory.in.ldap": "false"
            }
        },
        {
            "name": "firstName",
            "federationMapperType": "user-attribute-ldap-mapper",
            "config": {
                "ldap.attribute.name": "givenName",
                "user.model.attribute.name": "firstName",
                "read.only": "true",
